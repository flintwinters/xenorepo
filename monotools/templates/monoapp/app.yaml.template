name: {{app_name}}
title: {{app_title}}
module: apps.{{app_name}}.backend.server
imports:
  - monotools.orchestration.management
  - monotools.runtime.application
  - "monoui"
testing:
  python: tests
  browser:
    suite: tests/e2e/readiness.spec.ts
    proofs: [acceptance]
frontend:
  artifacts:
    index:
      format: preact
      source: frontend/index.tsx
      output: index.html
  routes:
    /: index
